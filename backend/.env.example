# FastAPI backend configuration (copy to backend/.env)

# Supabase (database + auth token verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Recommended server-side (never expose to the browser). Overrides SUPABASE_ANON_KEY when set,
# so the backend is not limited by RLS policies.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: OpenRouter takes precedence over OpenAI when both are set
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vapi voice assistant settings (public key stays in frontend/.env as NEXT_PUBLIC_VAPI_PUBLIC_KEY)
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini

# Frontend URL (sent as OpenRouter referer) and comma-separated CORS origins
APP_HOST_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
