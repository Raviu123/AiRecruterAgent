# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Vapi AI Voice Agent Web SDK Public Key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key

# App Host URL for Interview Links
NEXT_PUBLIC_HOST_URL=http://localhost:3000

# OpenRouter API Key (Used for AI Question Matrix & Candidate Feedback Report)
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: OpenRouter Model override (Default: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Standard OpenAI API Key (used as fallback if OPENROUTER_API_KEY is not set)
# OPENAI_API_KEY=your-openai-api-key
